# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Frontend URL(s) allowed by CORS — comma-separated for more than one
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (nginx, load balancer…). 0 = none.
TRUST_PROXY=0
# debug | info | warn | error
LOG_LEVEL=info

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=framecraft
# Or a single connection string instead of the DB_* values above.
# URL-encode special characters in the password (@ → %40, # → %23, : → %3A).
# DATABASE_URL=postgresql://frame_craft:your%40password@localhost:5432/frame_craft
# Max connections this API opens (keep total across all instances below the DB's max_connections)
DB_POOL_MAX=10
# Managed databases (RDS, Supabase, Neon…) usually need TLS:
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# ---------- Auth ----------
# Secret that signs and verifies JWTs (HS256). Long random string — production refuses
# anything under 32 characters. Generate one with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (sent as Bearer). Short on purpose; the refresh cookie renews it.
ACCESS_TOKEN_TTL=15m
# Refresh token (httpOnly cookie) lifetime in days
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies only travel over https. Defaults to true when NODE_ENV=production;
# set false only for local http development.
COOKIE_SECURE=false
